{
  "name": "@edd_remonts/ai-schadcn-chat",
  "version": "0.2.4",
  "packageManager": "pnpm@11.10.0",
  "description": "A fully-featured, deeply configurable AI chat panel for React 18/19 \u2014 works with any Anthropic / OpenAI / OpenAI-compatible API (OpenRouter, MiniMax, etc.)",
  "type": "module",
  "license": "MIT",
  "author": "ed <eddremonts86@gmail.com>",
  "homepage": "https://github.com/eddremonts86/ai-schadcn-chat",
  "repository": {
    "type": "git",
    "url": "https://github.com/eddremonts86/ai-schadcn-chat.git"
  },
  "bugs": {
    "url": "https://github.com/eddremonts86/ai-schadcn-chat/issues"
  },
  "keywords": [
    "react",
    "react-19",
    "chat",
    "ai",
    "anthropic",
    "openai",
    "openai-compatible",
    "shadcn",
    "shadcn-ui",
    "tanstack",
    "minimax",
    "openrouter",
    "llm",
    "chatbot",
    "mdx",
    "code-block",
    "file-upload"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks.cjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist/providers.cjs"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./typeset.css": "./dist/typeset.css",
    "./typeset-presets.css": "./dist/typeset-presets.css",
    "./scroller.css": "./dist/styles/scroller.css",
    "./marker.css": "./dist/styles/marker.css",
    "./surfaces.css": "./dist/styles/surfaces.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "demo": "vite --config demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json && node ./scripts/postbuild.mjs && node ./scripts/verify-dist.mjs",
    "build:dts": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "demo:og-assets": "node scripts/generate-demo-og-assets.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test:unit && npm run build",
    "verify:dist": "node ./scripts/verify-dist.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "next-mdx-remote": "^6.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "jsdom": "^30.0.1",
    "lucide": "1.45.0",
    "morphicons": "1.7.1",
    "oxlint": "^1.82.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
